# Salin file ini jadi ".env" lalu isi nilainya. Jangan commit file ".env" ke Git.

# Diisi setelah Supabase Edge Function di-deploy, contoh:
# VITE_API_BASE_URL=https://xxxxxxxxxxxx.supabase.co/functions/v1
VITE_API_BASE_URL=

# Client Key Midtrans (AMAN untuk publik, beda dengan Server Key).
# Ambil dari dashboard.midtrans.com > Settings > Access Keys
VITE_MIDTRANS_CLIENT_KEY=

# "sandbox" untuk uji coba, "production" kalau sudah siap terima uang sungguhan
VITE_MIDTRANS_ENV=sandbox
